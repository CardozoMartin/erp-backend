# =============================================================================
# VARIABLES DE ENTORNO — ERP Gestión Contable de Ventas
# =============================================================================
# Copiar este archivo como .env y completar todos los valores marcados con <<<
# El servidor NO arranca si falta alguna variable obligatoria.
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# URL del frontend (sin barra final). En local: http://localhost:5173
CORS_ORIGIN=https://tudominio.com   # <<<

# ── Base de datos MySQL ───────────────────────────────────────────────────────
DB_HOST=localhost                   # <<<
DB_PORT=3306
DB_USER=erp_user                    # <<<
DB_PASS=                            # <<< contraseña segura
DB_NAME=erp_db                      # <<<

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generá uno con: openssl rand -hex 32
JWT_SECRET=                         # <<<

# ── Clave maestra de cifrado ──────────────────────────────────────────────────
# Cifra las credenciales de email y backup almacenadas en la DB.
# Mínimo 32 caracteres. Generá uno con: openssl rand -hex 32
# IMPORTANTE: nunca cambies esta clave sin antes recifrar los datos en DB.
MASTER_ENCRYPT_KEY=                 # <<<

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Cifra los accessTokens de MP almacenados en la DB.
# Mínimo 32 caracteres. Generá uno con: openssl rand -hex 32
MP_ENCRYPT_KEY=                     # <<<

# Secret HMAC para validar notificaciones del webhook de MP.
# Obtenerlo en: Panel MP → Tus integraciones → Webhooks → Ver más
MP_WEBHOOK_SECRET=                  # <<<

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Panel: cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=              # <<<
CLOUDINARY_API_KEY=                 # <<<
CLOUDINARY_API_SECRET=              # <<<

# ── ARCA / AFIP (opcional — solo si vas a usar facturación electrónica) ───────
# Mínimo 16 caracteres. Si no lo definís, ARCA queda deshabilitado.
# ARCA_ENCRYPT_KEY=
