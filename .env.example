# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=pos_user
DB_PASS=tu_password
DB_NAME=tubase_db

# Entorno — controla synchronize de TypeORM y nivel de logs
# En producción DEBE ser "production" para deshabilitar synchronize automático
NODE_ENV=development

# JWT — OBLIGATORIO. Mínimo 16 caracteres. El servidor NO arranca si falta.
JWT_SECRET=cambiar_por_un_secreto_largo_y_seguro

# Puerto del servidor (default: 3000)
PORT=3000

# CORS — origen permitido del frontend
# En producción reemplazar por la URL real del frontend
CORS_ORIGIN=http://localhost:5173

# Cloudinary — credenciales del servicio de imágenes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MercadoPago — clave de cifrado AES-256-GCM para los accessTokens almacenados
# IMPORTANTE: rotar esta clave requiere recifrar todos los tokens guardados en la DB
MP_ENCRYPT_KEY=cambiar_por_clave_aes_256_bits

# Email SMTP (configuración por sucursal — se guarda en DB cifrada)
# Estas son las credenciales maestras de cifrado, no las del SMTP en sí

# Rate limiting (valores por defecto si no se definen)
# THROTTLE_TTL=60000    # ventana en ms (1 minuto)
# THROTTLE_LIMIT=300    # máx requests por ventana para la API general

# Redis — requerido para BullMQ (cola de tareas asíncronas) — pendiente Fase 2
# REDIS_URL=redis://localhost:6379
