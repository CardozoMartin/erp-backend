  },

  "21_update_producto_con_stock_nuevo": {
    "_descripcion": "Actualizar producto reemplazando su stock",
    "url": "PATCH /producto/:id",
    "body": {
      "precio_base": 20000,
      "stock": [
        {
          "cantidad": 200,
          "cantidad_minima": 20
        },
        {
          "sucursal_id": "sucursal-sur-003",
          "cantidad": 50,
          "cantidad_minima": 5
        }
      ]
    }
  },

  "_enums_referencia": {
    "UnidadVenta": ["UNIDAD", "KG", "GRAMO", "LITRO", "ML"],
    "RolImagen": ["PRINCIPAL", "GALERIA", "DETALLE", "BANNER", "MINIATURA"]
  }
