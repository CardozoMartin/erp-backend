  "15_stock_individual": {
    "_descripcion": "Crear stock por separado para un producto existente",
    "url": "POST /stock",
    "body": {
      "producto_id": "UUID-DEL-PRODUCTO-AQUI",
      "cantidad": 100,
      "cantidad_minima": 10
    }
  },

  "16_stock_individual_con_variante": {
    "_descripcion": "Crear stock para una variante específica",
    "url": "POST /stock",
    "body": {
      "producto_id": "UUID-DEL-PRODUCTO-AQUI",
      "variante_id": "UUID-DE-LA-VARIANTE-AQUI",
      "sucursal_id": "sucursal-centro-001",
      "cantidad": 25,
      "cantidad_minima": 5
    }
  },

  "17_ajustar_stock": {
    "_descripcion": "Ajustar stock (sumar o restar) — para ventas/compras",
    "url": "PATCH /stock/:id/ajustar",
    "body_sumar": {
      "cantidad": 10
    },
    "body_restar": {
      "cantidad": -3
    }
  },

  "18_imagen_individual": {
    "_descripcion": "Agregar imagen a un producto existente",
