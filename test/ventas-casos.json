{
  "casos": [
    {
      "nombre": "crear_cotizacion",
      "descripcion": "Crea una cotizacion con 2 items",
      "payload": {
        "estado": "COTIZACION",
        "caja_id": "11111111-1111-1111-1111-111111111111",
        "sucursal_id": "11111111-1111-1111-1111-111111111111",
        "cliente_id": "22222222-2222-2222-2222-222222222222",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "notas": "Cotizacion inicial",
        "items": [
          {
            "producto_id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
            "cantidad": 2
          },
          {
            "producto_id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
            "variante_id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
            "cantidad": 1,
            "descuento_porcentaje": 5
          }
        ]
      }
    },
    {
      "nombre": "actualizar_cotizacion",
      "descripcion": "Actualiza items y notas de una cotizacion",
      "payload": {
        "id": "VENTA_ID",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "body": {
          "notas": "Actualizacion de cotizacion",
          "items": [
            {
              "producto_id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
              "cantidad": 3
            }
          ]
        }
      }
    },
    {
      "nombre": "confirmar_orden",
      "descripcion": "Confirma la cotizacion y pasa a ORDEN_DE_VENTA",
      "payload": {
        "id": "VENTA_ID",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "body": {
          "descuento_total_extra": 100
        }
      }
    },
    {
      "nombre": "registrar_retiro_parcial",
      "descripcion": "Retiro parcial de items",
