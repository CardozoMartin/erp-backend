        "id": "VENTA_ID",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "body": {
          "items": [
            {
              "venta_item_id": "VENTA_ITEM_ID_1",
              "cantidad_retirada": 1
            }
          ]
        }
      }
    },
    {
      "nombre": "registrar_retiro_total",
      "descripcion": "Retiro total de items pendientes",
      "payload": {
        "id": "VENTA_ID",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "body": {
          "items": [
            {
              "venta_item_id": "VENTA_ITEM_ID_1",
              "cantidad_retirada": 2
            },
            {
              "venta_item_id": "VENTA_ITEM_ID_2",
              "cantidad_retirada": 1
            }
          ]
        }
      }
    },
    {
      "nombre": "facturar",
      "descripcion": "Factura la venta",
      "payload": {
        "id": "VENTA_ID",
        "usuario_id": "33333333-3333-3333-3333-333333333333",
        "body": {
          "tipo_comprobante": "B",
          "numero_comprobante": "0001-00001234",
          "condicion_pago": "CONTADO"
